PORT=3001
# Trinetra cloud brain — Gemini 3.5 Flash + 3-4 backups on 429 (server-side only, sanitized payload)
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-flash-latest
GEMINI_TIMEOUT_MS=20000
# Optional: CLOUD_PROVIDER=gemini  (set to "local" to force stub even if key present)
# Legacy aliases:
# GOOGLE_API_KEY=  # alias for GEMINI_API_KEY
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# PERPLEXITY_API_KEY=
