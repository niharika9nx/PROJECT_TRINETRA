PORT=3001
# Bind address. Defaults to 127.0.0.1 (loopback only). Do not set 0.0.0.0 —
# the server spends Gemini quota on every request and has no rate limiting.
HOST=127.0.0.1

# Optional shared secret. When set, every /api/* request must send the matching
# X-Trinetra-Token header. When unset, protection is the CORS allow-list
# (chrome-extension:// origins + loopback only) plus the loopback bind.
# TRINETRA_SERVER_TOKEN=

# Trinetra cloud brain — Gemini + fallback chain (server-side only, sanitized payload).
# If unset, the server runs the local rule-based stub and reports source "local-stub".
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3-flash-preview
GEMINI_TIMEOUT_MS=20000

# Optional: CLOUD_PROVIDER=local  (set to "local" to force the stub even if a key is present)
# Legacy aliases:
# GOOGLE_API_KEY=  # alias for GEMINI_API_KEY
