{
  "manifest_version": 3,
  "name": "Trinetra AI Web Agent",
  "version": "0.1.0",
  "description": "Privacy-preserving AI web agent — local-first reasoning with sanitized cloud escalation.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Trinetra Agent"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/providers/model_provider_interface.js",
        "lib/providers/stub_provider.js",
        "lib/local_reasoning.js",
        "lib/workflow_loop.js",
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
